# Auto-detect text files and normalize to LF in the repository
* text=auto

# Explicitly declare source file types as text (LF normalized)
*.cc      text
*.cmake   text
*.cpp     text
*.c       text
*.h       text
*.dart    text
*.swift   text
*.yaml    text
*.yml     text
*.json    text
*.md      text
*.sh      text
*.bat     text
*.ps1     text
*.cmake   text

# Go tooling compares the working tree byte for byte: gofmt rewrites CRLF to LF
# and `gofmt -l` then reports every file on a checkout that converted them
# (Windows runners default core.autocrlf to true). Pin LF so the check is about
# formatting, not line endings.
*.go      text eol=lf

# Binary files should remain untouched
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.ttf     binary
*.woff    binary
*.woff2   binary
