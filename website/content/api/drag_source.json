        {
          "key": "DragSource::StartDragging",
          "kind": "method",
          "doc": {
            "summary": "Starts dragging the data out of a window.",
            "details": "The call returns right away; the drag continues in the platform's drag loop, and DragSourceEndedEvent is emitted when it is over.",
            "params": [
              {
                "name": "window",
                "text": "The window the drag starts from. The drag image appears under the cursor."
              }
            ],
            "returns": "false if the platform does not support dragging, the window is gone, there is no data to drag (no files and no text), the operation is DragOperation::None, the primary mouse button is not held down, or a drag is already in progress.",
            "notes": [
              {
                "kind": "note",
                "text": "Platform availability:\n- macOS: ✅ Fully supported - Starts an NSDraggingSession from the content view\n- Windows: ✅ Fully supported - Runs DoDragDrop on the next turn of the message loop\n- Linux: ✅ Fully supported - Starts a GTK drag on the window\n- Android: ❌ Not applicable - Returns false\n- iOS: ❌ Not applicable - Returns false\n- OpenHarmony: ❌ Not applicable - Returns false"
              }
            ]
          },
