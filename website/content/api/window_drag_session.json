        {
          "key": "WindowDragSession::Start",
          "kind": "method",
          "doc": {
            "summary": "Start following the cursor until the primary mouse button is released.",
            "details": "If the primary button is not held down when the session starts, the window is left where it is and the session ends right away with a WindowDragEndedEvent.\n\nCalling Start() on an active session retargets it: the previous target is released without a WindowDragEndedEvent or WindowDragCancelledEvent, so the same gesture can continue with a different window.",
            "params": [
              {
                "name": "window",
                "text": "The window to move with the cursor, or nullptr to only track the cursor."
              },
              {
                "name": "anchor",
                "text": "The point of the window, relative to its top-left frame corner, that stays under the cursor. Ignored without a window. Note that the frame includes the title bar; add the offset between Window::GetBounds() and Window::GetContentBounds() to anchor on a point inside the content."
              }
            ],
            "returns": "false if the platform cannot track the cursor globally.",
            "notes": [
              {
                "kind": "note",
                "text": "Platform availability:\n- macOS: ✅ Fully supported - Global cursor and button state\n- Windows: ✅ Fully supported - Global cursor and button state\n- Linux: ⚠️ X11 only - Returns false on a Wayland session, where a client can neither read the global pointer nor place its own windows; run under Xwayland (GDK_BACKEND=x11), or move a window with Window::StartDragging(), which the compositor carries out\n- Android: ❌ Not applicable - Always returns false\n- iOS: ❌ Not applicable - Always returns false\n- OpenHarmony: ❌ Not applicable - Always returns false"
              }
            ]
          },
