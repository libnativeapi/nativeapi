    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
