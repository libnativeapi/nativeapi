{
  "name": "nativeapi-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:docs": "node scripts/build-docs.mjs",
    "dev": "node scripts/build-docs.mjs && vite --port 3000",
    "generate-routes": "tsr generate",
    "build": "node scripts/build-docs.mjs && vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "preview": "vite preview --port 3000",
    "check-types": "node scripts/build-docs.mjs && tsc --noEmit"
  },
  "dependencies": {
